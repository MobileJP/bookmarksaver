# Copy to .env and fill in your values

# Supabase (get from https://supabase.com → Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret-key

# Optional: password to protect your vault (leave blank for no password)
VITE_ACCESS_PASSWORD=your-secret-password
